# Development Environment Variables Template
# Copy this file to .env.local and fill in your values (never commit .env.local)

# --- Database Configuration (Supabase - Drizzle ORM) ---
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# --- Supabase Configuration (Server-Only) ---
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# --- AI/LLM Configuration ---
OPENROUTER_API_KEY="your-openrouter-api-key"

# --- Application & Contact Configuration ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_COMPANY_WEBSITE="https://example.com"
NEXT_PUBLIC_COMPANY_WHATSAPP="+1 000 000 0000"
NEXT_PUBLIC_COMPANY_EMAIL="contact@example.com"
